# Platform Database
PLATFORM_DB_HOST=${DB_HOST}
PLATFORM_DB_PORT=${DB_PORT}
PLATFORM_DB_NAME=hrms_platform_prod
PLATFORM_DB_USER=${DB_USER}
PLATFORM_DB_PASSWORD=${DB_PASSWORD}
PLATFORM_DB_DIALECT=postgres

# Tenant Database
TENANT_DB_HOST=${DB_HOST}
TENANT_DB_PORT=${DB_PORT}
TENANT_DB_USER=${DB_USER}
TENANT_DB_PASSWORD=${DB_PASSWORD}
TENANT_DB_DIALECT=postgres

# Services
AUTH_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
API_GATEWAY_PORT=3000

# JWT/Security
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=24h

# Environment
NODE_ENV=production
