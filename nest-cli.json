{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json"
  },
  "monorepo": true,
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "organization-service": {
      "type": "application",
      "root": "apps/organization-service",
      "entryFile": "main",
      "sourceRoot": "apps/organization-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/organization-service/tsconfig.app.json"
      }
    },
    "attendance-leave-service": {
      "type": "application",
      "root": "apps/attendance-leave-service",
      "entryFile": "main",
      "sourceRoot": "apps/attendance-leave-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/attendance-leave-service/tsconfig.app.json"
      }
    },
    "payroll-service": {
      "type": "application",
      "root": "apps/payroll-service",
      "entryFile": "main",
      "sourceRoot": "apps/payroll-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payroll-service/tsconfig.app.json"
      }
    },
    "performance-work-service": {
      "type": "application",
      "root": "apps/performance-work-service",
      "entryFile": "main",
      "sourceRoot": "apps/performance-work-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/performance-work-service/tsconfig.app.json"
      }
    },
    "recruitment-service": {
      "type": "application",
      "root": "apps/recruitment-service",
      "entryFile": "main",
      "sourceRoot": "apps/recruitment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/recruitment-service/tsconfig.app.json"
      }
    },
    "lms-service": {
      "type": "application",
      "root": "apps/lms-service",
      "entryFile": "main",
      "sourceRoot": "apps/lms-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/lms-service/tsconfig.app.json"
      }
    }
  }
}
